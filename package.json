{
  "name": "maproom",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/data/build-illustrations.mjs",
    "build": "tsc -b && vite build && node scripts/generate-seo-routes.mjs && node scripts/build-precache-manifest.mjs && node scripts/validate-production-artifacts.mjs",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run build && playwright test",
    "data:sync": "node scripts/data/build-geography.mjs",
    "data:watersheds": "node scripts/data/build-watershed-match.mjs",
    "data:watersheds:audit": "node scripts/data/audit-watershed-match.mjs",
    "data:geometries": "node scripts/data/rebuild-country-geometries.mjs",
    "qa:outlines": "node scripts/data/render-outline-catalogue.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/nunito-sans": "^5.3.0",
    "d3-geo": "^3.1.2",
    "flag-icons": "^7.6.0",
    "idb": "^8.0.4",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "oxlint": "^1.90.0",
    "topojson-server": "^3.0.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
